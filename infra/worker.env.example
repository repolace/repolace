# Environment for the task `worker` container: copy to infra/worker.env (gitignored) and fill in.
#
# Only the task worker loads this file. It is the one service that needs the GitHub App key and
# the model providers' keys; the `api` and `worker-maintenance` services must never get them.
# DATABASE_URL, REDIS_URL and CELERY_BROKER_URL, DOCKER_HOST, WORKER_ROLE and WORKSPACE_PARENT_DIR
# are set by docker-compose.yml and must not be repeated here. To move the workspace or the docker
# socket, set WORKSPACE_PARENT_DIR / DOCKER_SOCKET in infra/.env (what compose reads for
# interpolation), not in this file.

# The GitHub App the pipeline clones and pushes as. The private key is the App's PEM,
# base64-encoded on one line.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Model providers (gateway/models.toml routes each stage to a model). Fill in the key for each
# provider your models.toml actually uses and leave the others empty. They are handed to LiteLLM
# per call and are never exported into the process environment, so git, docker and the sandbox
# cannot inherit them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=
# A Vertex AI API key (not an AI Studio key), for the vertex-gemini-* models.
GOOGLE_API_KEY=

# Optional. Uncomment to change a default.
#
# Point the agent stage (and the resolver) at another model without editing models.toml. JSON,
# stage -> model key. Must be non-empty if present:
# GATEWAY_STAGE_MODELS={"agent": "comparison-a"}
# AWS profile and region for `bedrock` models (no long-lived key sits in this file):
# GATEWAY_AWS_PROFILE=
# GATEWAY_AWS_REGION=
#
# Prefork children, and so concurrent tasks (about 10 GB of RAM for 3):
# WORKER_CONCURRENCY=3
# Seconds before one task is stopped. infra/rabbitmq.conf is sized for the default; if you raise
# this, raise its consumer_timeout to at least tasks.required_consumer_timeout_ms too, or the
# broker will close the channel of a task that is still running:
# WORKER_TASK_BOUND_SECONDS=11700
# Largest change a task may open a PR for:
# MAX_CHANGED_FILES=10
# MAX_CHANGED_LINES=500
