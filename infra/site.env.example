# Environment for the public `site` container: copy to infra/site.env (gitignored) and fill in.
#
# This is the only env file the internet-facing site process loads. It lists exactly what
# `SiteSettings` (api/repolace_api/config.py) reads. It holds no GitHub App, broker or provider key:
# the site never enqueues work and never calls a model.

# The Host values the site answers to (comma-separated). Anything else gets a 400.
SITE_ALLOWED_HOSTS=repolace.rounakkumarsingh.com

# A Postgres role that may INSERT into waitlist_signups and nothing else. Unset: the form answers 503.
# postgresql+asyncpg://repolace_site:<password>@postgres:5432/repolace
SITE_DATABASE_URL=

# Cloudflare Turnstile (optional; set both to turn the human check on).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Trust CF-Connecting-IP when the TCP peer is loopback or a private address (the tunnel connector on
# the same host, directly or over a Docker bridge). The port is published on 127.0.0.1 only.
SITE_TRUST_CF_IP=true
