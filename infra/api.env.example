# Environment for the `api` container: copy to infra/api.env (gitignored) and fill in.
#
# This is the only env file the internet-facing API process loads. It lists exactly what
# `ApiSettings`, `UiSettings` (api/repolace_api/config.py) and `ArcjetSettings`
# (api/repolace_api/protection.py) read, and a test keeps it equal to
# them. Provider keys (ANTHROPIC_API_KEY, ...) belong in infra/worker.env and never here: the API
# never calls a model, and a key in this process's environment is a key an attacker who finds a
# bug in a web-facing handler can read.

# Set by docker-compose.yml for the containers it starts (its `environment:` wins over this
# file). Fill them in only to run the API outside compose.
DATABASE_URL=
REDIS_URL=
CELERY_BROKER_URL=

# The GitHub App. The private key is the App's PEM, base64-encoded on one line.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=

# Where GitHub sends the user back to, and the Host values the UI and API answer to
# (comma-separated; add a tunnel hostname here).
API_BASE_URL=http://localhost:8000
UI_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Arcjet request protection (rate limits and Shield on the routes). Unset ARCJET_KEY means none.
# Get the site key with `npx -y @arcjet/cli@latest sites get-key` or from console.arcjet.com.
# Start in DRY_RUN (decisions are recorded, nothing is blocked), read them in the console, then LIVE.
# Behind a tunnel or proxy, list its IP/CIDR in ARCJET_TRUSTED_PROXIES and start uvicorn with a
# matching --forwarded-allow-ips, or every client shares the proxy's address and its rate limit.
# ARCJET_SCAN_ISSUES=true sends issue text (possibly from private repos) to Arcjet; leave it false
# unless you accept that.
ARCJET_KEY=
ARCJET_MODE=DRY_RUN
ARCJET_TRUSTED_PROXIES=
ARCJET_SCAN_ISSUES=false
