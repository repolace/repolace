dist/
build/
.env
.env.*
!.env.example
# Committed symlink to the repo-root .env. Compose interpolates from a .env in
# its own project directory, so without this `docker compose -f infra/...` would
# silently use the fallback password while the services use the real one.
!infra/.env

node_modules/
.DS_Store

