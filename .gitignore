__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.env
.env.*
!.env.example
# Committed symlink to the repo-root .env. Compose interpolates from a .env in
# its own project directory, so without this `docker compose -f infra/...` would
# silently use the fallback password while the services use the real one.
!infra/.env

# Per-service compose env files (the committed copies are the *.env.example files).
infra/api.env
infra/worker.env

node_modules/
.DS_Store

# Benchmark harness output: per-run artifacts and the downloaded dataset cache.
eval/runs/
eval/cache/

.pytest_cache/
.ruff_cache/
.mypy_cache/

# design-hook scratch output
.impeccable/

# Claude Code: commit the path-scoped rules, nothing else (settings.local.json, worktrees/).
.claude/*
!.claude/rules/
