DATABASE_URL=postgresql+asyncpg://repolace:repolace@localhost:5432/repolace
REDIS_PASSWORD=repolace
REDIS_URL=redis://:repolace@localhost:6379/0
CELERY_BROKER_URL=amqp://repolace:repolace@localhost:5672//

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_WEBHOOK_SECRET=
API_BASE_URL=http://localhost:8000

# The Verify sandbox talks to a *rootless* daemon. Without this the CLI finds
# /var/run/docker.sock instead, and membership of the `docker` group needed to
# reach it is root-equivalent on the host -- the posture the sandbox exists to
# avoid. Set up with `dockerd-rootless.sh` via the shipped user unit:
#   systemctl --user enable --now docker
DOCKER_HOST=unix:///run/user/1000/docker.sock
